# Postgres. On Vercel, connecting a Neon database sets both of these.
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_dev"
# Direct (non-pooled) connection for migrations; falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=""

# Sign-in. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Who may use the admin area: Google accounts on this domain that are on the
# Users list. Bootstrap admins need no row, so the first admin can add others.
STAFF_EMAIL_DOMAIN="neoregenlab.com"
BOOTSTRAP_ADMIN_EMAILS="you@neoregenlab.com"

# Origin printed into the QR codes. Must be the final domain before cards are printed.
PUBLIC_BASE_URL="http://localhost:3000"

# Lot documents. Connecting a Blob store on Vercel sets BLOB_STORE_ID (or, on
# older setups, BLOB_READ_WRITE_TOKEN). Without either, files are stored under
# .data/uploads (local only).
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Email through Resend. Without a key, emails are logged instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="NeoRegen <portal@neoregenlab.com>"
# New-report and adverse-event notices (comma-separated).
QA_EMAIL=""
# Shown to customers in the page footer.
SUPPORT_EMAIL=""

# Local development only: email + password sign-in. Ignored in production.
ALLOW_DEV_LOGIN="1"
